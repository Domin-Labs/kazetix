# Kazetix server configuration. Copy to .env and fill in. Never commit .env.

# Public HTTPS URL of this server (used for OAuth metadata and signed audio links).
PUBLIC_BASE_URL=https://kazetix.example.com

# Bearer token the desktop app uses for the REST API (also accepted by /mcp for headless clients).
# Generate: openssl rand -base64 32
KAZETIX_API_TOKEN=

# Owner password for the MCP OAuth sign-in page (claude.ai / Claude Code connectors).
KAZETIX_MCP_PASSWORD=

# OpenRouter: exact transcript, summaries and action items.
# Set a credit limit on the key.
OPENROUTER_API_KEY=
SUMMARY_MODEL=anthropic/claude-sonnet-5.5
# STT_MODEL=elevenlabs/scribe-v2

# Optional
# DEFAULT_LANGUAGE=cs
# DATA_DIR=/data
# PORT=8767


# Optional public waitlist form for the website: comma-separated allowed origins; empty = endpoint off.
# Read the list with GET /api/waitlist (Bearer KAZETIX_API_TOKEN).
# WAITLIST_ORIGINS=https://kazetix.com,https://www.kazetix.com
